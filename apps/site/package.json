{
  "name": "@lyra-ds/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/derive-stats.mjs && node scripts/generate-headers.mjs",
    "pretest": "pnpm --filter @lyra-ds/react run build && pnpm run build",
    "build": "next build",
    "pretypecheck": "node scripts/derive-stats.mjs",
    "update-sponsors": "node scripts/update-sponsors.mjs",
    "test": "node --test scripts/landing-sections.test.mjs scripts/consent.test.mjs scripts/analytics.test.mjs scripts/metadata-deploy.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@lyra-ds/react": "workspace:*",
    "@lyra-ds/styles": "workspace:*",
    "next": "16.3.1",
    "next-intl": "4.13.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "sponsorkit": "18.0.0",
    "typescript": "5.9.3"
  }
}
