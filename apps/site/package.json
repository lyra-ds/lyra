{
  "name": "@lyra-ds/site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/derive-stats.mjs && node scripts/generate-headers.mjs",
    "pretest": "pnpm --filter @lyra-ds/react run build && pnpm run build",
    "build": "next build",
    "pretypecheck": "node scripts/derive-stats.mjs",
    "test": "node --test scripts/landing-sections.test.mjs scripts/consent.test.mjs scripts/analytics.test.mjs scripts/metadata-deploy.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/plus-jakarta-sans": "5.2.8",
    "@lyra-ds/react": "workspace:*",
    "@lyra-ds/styles": "workspace:*",
    "next": "16.2.10",
    "next-intl": "4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3"
  }
}
