{
  "name": "@lyra-ds/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/copy-llms.mjs && node scripts/generate-headers.mjs",
    "build": "next build",
    "pretest": "pnpm --filter @lyra-ds/react run build && pnpm --filter @lyra-ds/docs run build",
    "test": "node --test scripts/consent.test.mjs scripts/analytics.test.mjs scripts/consent-export.test.mjs scripts/check-stack-sections.test.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@lyra-ds/react": "workspace:*",
    "@lyra-ds/styles": "workspace:*",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "15.2.3",
    "next": "16.3.1",
    "next-intl": "4.13.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
