{
  "name": "@lyra-ds/react",
  "version": "0.0.0",
  "description": "Lyra DS — thin, tree-shakable React wrappers over @lyra-ds/styles. All appearance comes from .lyra-* classes; zero runtime CSS-in-JS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./button": {
      "import": {
        "types": "./dist/button.d.ts",
        "default": "./dist/button.js"
      },
      "require": {
        "types": "./dist/button.d.cts",
        "default": "./dist/button.cjs"
      }
    },
    "./input": {
      "import": {
        "types": "./dist/input.d.ts",
        "default": "./dist/input.js"
      },
      "require": {
        "types": "./dist/input.d.cts",
        "default": "./dist/input.cjs"
      }
    },
    "./dialog": {
      "import": {
        "types": "./dist/dialog.d.ts",
        "default": "./dist/dialog.js"
      },
      "require": {
        "types": "./dist/dialog.d.cts",
        "default": "./dist/dialog.cjs"
      }
    },
    "./icon": {
      "import": {
        "types": "./dist/icon.d.ts",
        "default": "./dist/icon.js"
      },
      "require": {
        "types": "./dist/icon.d.cts",
        "default": "./dist/icon.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "1.25.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@lyra-ds/styles": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "import { Button } from '@lyra-ds/react/button'",
      "path": "dist/button.js",
      "import": "{ Button }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "300 B"
    },
    {
      "name": "import { Icon } from '@lyra-ds/react/icon' (70-icon registry, lucide measured)",
      "path": "dist/icon.js",
      "import": "{ Icon }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "7.5 kB"
    }
  ]
}
