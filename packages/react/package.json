      }
    },
    "./icon-button": {
      "import": {
        "types": "./dist/icon-button.d.ts",
        "default": "./dist/icon-button.js"
      },
      "require": {
        "types": "./dist/icon-button.d.cts",
        "default": "./dist/icon-button.cjs"
      }
    },
    "./badge": {
      "import": {
        "types": "./dist/badge.d.ts",
