{
  "name": "@lyra-ds/react",
  "version": "0.0.0",
  "description": "Lyra DS — thin, tree-shakable React wrappers over @lyra-ds/styles. All appearance comes from .lyra-* classes; zero runtime CSS-in-JS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
