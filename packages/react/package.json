    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "1.25.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@lyra-ds/styles": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "import { Button } from '@lyra-ds/react/button'",
      "path": "dist/button.js",
      "import": "{ Button }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "300 B"
    },
    {
      "name": "import { Icon } from '@lyra-ds/react/icon' (70-icon registry, lucide measured)",
      "path": "dist/icon.js",
      "import": "{ Icon }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "7.5 kB"
    },
    {
      "name": "import { IconButton } from '@lyra-ds/react/icon-button'",
      "path": "dist/icon-button.js",
      "import": "{ IconButton }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "400 B"
    },
    {
      "name": "import { Textarea } from '@lyra-ds/react/textarea'",
      "path": "dist/textarea.js",
      "import": "{ Textarea }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "600 B"
    },
    {
      "name": "import { Checkbox } from '@lyra-ds/react/checkbox'",
      "path": "dist/checkbox.js",
      "import": "{ Checkbox }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "500 B"
    },
    {
      "name": "import { Radio } from '@lyra-ds/react/radio'",
      "path": "dist/radio.js",
      "import": "{ Radio }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "500 B"
    },
    {
      "name": "import { Switch } from '@lyra-ds/react/switch'",
      "path": "dist/switch.js",
      "import": "{ Switch }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "500 B"
    },
    {
      "name": "import { FileUpload } from '@lyra-ds/react/file-upload'",
      "path": "dist/file-upload.js",
      "import": "{ FileUpload }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "8 kB"
    },
    {
      "name": "import { Badge } from '@lyra-ds/react/badge'",
      "path": "dist/badge.js",
      "import": "{ Badge }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "400 B"
    },
    {
      "name": "Tag (curated icon registry)",
      "path": "dist/tag.js",
      "import": "{ Tag }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "8 kB"
    },
    {
      "name": "import { Card } from '@lyra-ds/react/card'",
      "path": "dist/card.js",
      "import": "{ Card }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "500 B"
    },
    {
      "name": "import { Avatar } from '@lyra-ds/react/avatar'",
      "path": "dist/avatar.js",
      "import": "{ Avatar }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "500 B"
    },
    {
      "name": "import { Alert } from '@lyra-ds/react/alert'",
      "path": "dist/alert.js",
      "import": "{ Alert }",
      "ignore": [
        "react",
        "react-dom"
      ],
