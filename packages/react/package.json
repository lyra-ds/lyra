      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "400 B"
    },
    {
      "name": "import { Skeleton } from '@lyra-ds/react/skeleton'",
      "path": "dist/skeleton.js",
      "import": "{ Skeleton }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "500 B"
    },
    {
      "name": "import { Progress } from '@lyra-ds/react/progress'",
      "path": "dist/progress.js",
      "import": "{ Progress }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "500 B"
    },
    {
      "name": "import { Stat } from '@lyra-ds/react/stat'",
