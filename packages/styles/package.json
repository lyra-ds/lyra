{
  "name": "@lyra-ds/styles",
  "version": "0.1.1",
  "description": "Lyra DS — CSS-first design tokens + component styles (209 tokens, 40 components), zero JS.",
  "license": "MIT",
  "homepage": "https://lyra-ds.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyra-ds/lyra.git",
    "directory": "packages/styles"
  },
  "bugs": "https://github.com/lyra-ds/lyra/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./styles.css",
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./compat-shadcn.css": "./compat-shadcn.css"
  },
  "files": [
    "styles.css",
    "tokens",
    "components",
    "compat-shadcn.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint:css": "stylelint \"**/*.css\"",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
