{
  "name": "@lyra-ds/styles",
  "version": "0.5.0",
  "description": "Lyra DS — CSS-first design tokens + component styles (211 tokens, 78 components), zero JS.",
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "white-label",
    "theming",
    "dark-mode",
    "ui",
    "components"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/lyra-ds",
  "homepage": "https://lyra-ds.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyra-ds/lyra.git",
    "directory": "packages/styles"
  },
  "bugs": "https://github.com/lyra-ds/lyra/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./styles.css",
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./compat-shadcn.css": "./compat-shadcn.css"
  },
  "files": [
    "styles.css",
    "tokens",
    "components",
    "compat-shadcn.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint:css": "stylelint \"**/*.css\"",
    "test:browser": "vitest run --browser.name chromium && vitest run --browser.name firefox && vitest run --browser.name webkit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
