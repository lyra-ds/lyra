.planning/research/.cache/
node_modules/
dist/

# Compozy workspace state — a local id, a timestamp and the absolute path of the
# checkout that created it. Machine-specific by construction; never shared.
.compozy/
*.tsbuildinfo
.env*
# Next build output — matched per app, so a new app under apps/ is covered the
# day it is created rather than the day someone notices its artifacts in a diff.
apps/*/.next/
apps/*/out/
apps/docs/.source/
apps/docs/public/llms.txt
apps/site/lib/generated/
apps/site/public/_headers
apps/docs/public/_headers

# Vitest Browser Mode generated artifacts (failure screenshots / attachments)
**/__screenshots__/
**/.vitest-attachments/

# Playwright MCP screenshots/artifacts
.playwright-mcp/
# Ad-hoc browser screenshots taken at the repo root while verifying a change by hand.
# They are debug scratch, never deliverables — two slipped into #183 because a stray `rm`
# ran from another directory and `-f` swallowed the miss.
/*.png
